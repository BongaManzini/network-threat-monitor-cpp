<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Network Monitor App" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/network_monitor" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=c++17" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-pthread" />
					<Add library="ws2_32" />
					<Add library="iphlpapi" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/network_monitor" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=c++17" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-pthread" />
					<Add library="ws2_32" />
					<Add library="iphlpapi" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add directory="include" />
		</Compiler>
		<Unit filename="include/AegisConnector.hpp" />
		<Unit filename="include/Platform.hpp" />
		<Unit filename="include/Sniffer.hpp" />
		<Unit filename="include/ThreatDetector.hpp" />
		<Unit filename="src/AegisConnector.cpp" />
		<Unit filename="src/Sniffer.cpp" />
		<Unit filename="src/ThreatDetector.cpp" />
		<Unit filename="src/main.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
